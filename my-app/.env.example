# Copy this file to .env.local and fill it in. Never commit .env.local.

# PostgreSQL connection (pg reads these PG* variables on its own).
# Using separate variables means special characters in the password
# (like @ or #) need no escaping.
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=passvault

# Or use a single connection string instead of the PG* lines above:
# DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/passvault

# Run `npm run gen-keys` and paste both lines here.
# ENCRYPTION_KEY encrypts every saved password. If you lose it, saved
# passwords cannot be decrypted. If someone else gets it along with a
# copy of the database, they can decrypt everything.
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

NEXTAUTH_URL=http://localhost:3000

# Optional: Google sign-in. Leave blank to use email and password only.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# with redirect URI http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
